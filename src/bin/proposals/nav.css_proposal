/* ==========================================
   1. GLOBAL & STICKY FOOTER LAYOUT
   ========================================== */
body {
    margin: 0;
    margin-left: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh; /* Forces body to take full screen height */
}

/* This expands to push the footer to the bottom when content is short */
main {
    flex: 1; 
}

/* ==========================================
   2. SHARED NAV & FOOTER STYLES
   ========================================== */
nav, footer {
    background-color: rgba(255, 255, 255, 0.4);
    user-select: none;
    -moz-user-select: none;
}

/* ==========================================
   3. NAVIGATION STYLES (DESKTOP DEFAULT)
   ========================================== */
nav {
    box-shadow: 0 8px 6px -6px #333;
    width: 100%;
    position: relative;
    transition: all 0.3s ease-in-out;
}

.menu-toggle {
    display: none;
    background: transparent;
    color: black;
    border: none;
    font-size: 32px;
    font-weight: bold;
    cursor: pointer;
    padding: 10px;
}

nav section {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    padding: 20px;
    box-sizing: border-box;
}

nav section ul {
    list-style-type: none;
    display: flex;
    flex-direction: row;  
    gap: 20px;
    padding: 2px;
    margin: 0;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;       
}

nav section ul li {
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

.logo-parent, a {
    padding: 0;
    margin: 0;
}

nav ul:nth-child(1) li .div a {
    text-decoration: none;
    font-weight: 900;
    font-size: 50px;
    color: transparent;
    background: linear-gradient(to left, #FFA500, #FF8C00, darkorange, #bdde85, #74da74, #4dcc4d);
    background-clip: text;
    -moz-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.04em;
    -webkit-text-stroke: 0.5px black;
    position: relative; 
    display: inline-block; 
}

nav ul li a {
    text-decoration: none;
    color: black;
    font-weight: bold;
    font-size: 20px;
}

nav ul li a:hover {
    text-decoration: underline;
}

nav section ul li:nth-child(5) a {
    color: #333 !important;
}

nav section ul:nth-child(1) li .div {
    display: flex;
    align-items: center;
    cursor: pointer;
    gap: 0.45em;
    font-size: 24px; 
}

nav section ul li .div img {
    height: 3.125em;
    width: auto;
    display: block; 
    object-fit: contain; 
}

/* ==========================================
   4. MOBILE RESPONSIVE STYLES (<= 768px)
   ========================================== */
@media screen and (max-width: 768px) {
    .marquee {
        display:none;
    }
    nav {
        position: fixed;
        top: 0;
        left: 0;
        width: 60px;               
        height: 60px;
        box-shadow: none; 
        z-index: 2000;
        background-color: rgba(255, 255, 255, 0.7);
        overflow: hidden;
        padding:0;
        margin:0;
        display: grid;
        place-items: center;
    }
    nav section {
        padding:0;
        margin:0;
    }
    nav:has(.menu-toggle:hover):not(.open) {
        background-color: rgba(255, 255, 255, 0.9);
    }
    nav:not(.open){
        height:100%;
    }

    .menu-toggle {
        display: block;
        position:absolute;
        top: 50%;           
        left: 50%;          
        transform: translate(-50%, -50%);
    }

    nav section {
        display: none;
        opacity: 0;
        height: calc(100vh - 60px);
        margin-top: 60px;
        flex-direction: column;    
        justify-content: flex-start;
        align-items: flex-start;   
        padding: 20px 24px;
    }

    nav.open {
        width: 280px;
        height: 100vh;
        box-shadow: 6px 0 8px -6px #333;
    }

    nav.open section {
        display: flex;
        opacity: 1;
    }
    nav.open .menu-toggle {
        position:absolute;
        top:20px;
        left:20px;
    }

    nav section ul {
        flex-direction: column;    
        align-items: flex-start;   
        justify-content: flex-start;
        width: 100%;
        gap: 25px;                 
    }

    nav section ul li {
        justify-content: flex-start;
        width: fit-content;
        padding: 5px;
    }
    
    nav section ul li:hover {
        justify-content: flex-start;
        width: 100%;
    }
    
    nav section ul li:nth-last-child(1) a::before {
        content: "Search "
    }
}

/* ==========================================
   5. ANIMATIONS
   ========================================== */
.spin-active {
    animation: spin 0.6s ease-in-out;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* ==========================================
   6. FOOTER STYLES
   ========================================== */
footer {
    box-shadow: 0px -15px 10px -10px #333;
    width: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
    margin-top: auto; /* Extra fallback safety to ensure it remains at the bottom */
}

footer span {
    text-align: center;
    margin: 4px auto;
}

footer section {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
}

footer ul {
    list-style-type: none;
    display: flex;
    gap: 20px;
    margin: 5px;
}

footer ul li strong {
    font-size: 22px;
    margin-bottom: 20px;
}

footer ul li ul {
    padding: 1px;
    margin-top: 5px;
    display: flex;
    gap: 7px;
    flex-direction: column;
    list-style-type: '🪿' !important;
}

footer ul li ul li a {
    font-size: 17px;
    color: rgb(27, 27, 49);
    text-decoration: none;
}

footer ul li ul li a:hover {
    text-decoration: underline;
}
